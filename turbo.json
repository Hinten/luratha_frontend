{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.base.mjs",
    "eslint.firestore-guards.mjs",
    "prettier.config.mjs",
    ".prettierignore"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:coverage": {},
    "test:seo": {},
    "test:firestore": {
      "cache": false
    },
    "test:functions:cloud": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
