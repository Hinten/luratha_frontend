{
  "name": "@luratha/store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:firestore": "vitest run --config vitest.cloud.config.mts",
    "test:functions:cloud": "vitest run --config vitest.cloud-functions.config.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cloud": "vitest run --config vitest.cloud.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@luratha/auth": "workspace:*",
    "@luratha/core": "workspace:*",
    "@luratha/firestore": "workspace:*",
    "@luratha/payments": "workspace:*",
    "@luratha/repositories": "workspace:*",
    "@luratha/schemas": "workspace:*",
    "@mercadopago/sdk-react": "^1.0.7",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.10.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@luratha/devtools": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
