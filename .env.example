# ─────────────────────────────────────────────────────────────────────────────
# Template de variáveis de ambiente do Luratha frontend.
# Existe UM único `.env` na raiz do repositório (não versionado). O tooling de
# apps/store/ (Next.js, Vitest, Playwright) o carrega via apps/store/loadRootEnv.ts.
#
#   cp .env.example .env
#
# NUNCA commite `.env` nem tokens/segredos reais.
# ─────────────────────────────────────────────────────────────────────────────

# ── Melhor Envio (cálculo de frete) ──────────────────────────────────────────
# Como obter o token: docs/melhor-envio-setup.md
# Token Bearer gerado no painel do Melhor Envio (sandbox OU produção).
MELHOR_ENVIO_TOKEN=""
# "sandbox" (default) ou "production". O token deve ser do mesmo ambiente.
MELHOR_ENVIO_ENV="sandbox"
# Header User-Agent exigido pela API — identifique a loja + e-mail de contato.
MELHOR_ENVIO_USER_AGENT="Luratha (contato@luratha.com.br)"

# ── MercadoPago (pagamento) ──────────────────────────────────────────────────
# Como obter as credenciais: docs/mercadopago-setup.md
# Access token do servidor. Tokens de teste podem começar com "TEST-" (nem sempre),
# tokens de produção com "APP_USR-". Use a flag MERCADOPAGO_ENV abaixo para
# garantir a detecção correta do ambiente.
MERCADOPAGO_ACCESS_TOKEN=""
# "sandbox" ou "production". Quando ausente, cai pra detecção pelo prefixo do
# token (TEST- → sandbox). Setar explicitamente é o caminho confiável porque
# o painel MP nem sempre gera credenciais TEST com o prefixo TEST-.
MERCADOPAGO_ENV="sandbox"
# Email do test user comprador criado no painel MP (Suas integrações → Sua
# aplicação → Contas de teste). Em sandbox o servidor reescreve `payer.email`
# por esse valor — sem isso, o cartão falha com `invalid_users_involved`.
# Ignorada em produção.
MERCADOPAGO_SANDBOX_PAYER_EMAIL=""
# Secret de assinatura dos webhooks (painel MP → Webhooks). Usado para validar
# o header `x-signature` das notificações.
MERCADOPAGO_WEBHOOK_SECRET=""
# Public key do MercadoPago — exposta ao browser para tokenizar o cartão via
# Card Payment Brick (@mercadopago/sdk-react). Usada na UI do checkout.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID GA4 (G-XXXXXXXX). Apenas FALLBACK: a fonte da verdade é o admin
# (/configuracoes/marketing → settings/global.marketing.ga4MeasurementId). Defina
# aqui só se preferir configurar por ambiente. Vazio = analytics desligado na loja.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Firebase — client SDK (browser) ──────────────────────────────────────────
# Valores do app web no console do Firebase. Prefixo NEXT_PUBLIC_ = expostos ao
# cliente (é o esperado para config Firebase de browser).
# No Firebase App Hosting estas variáveis NÃO precisam ser definidas: o App
# Hosting injeta a config web automaticamente (em build e runtime) via a
# variável reservada FIREBASE_WEBAPP_CONFIG, que o código também lê.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase — admin SDK (servidor) ──────────────────────────────────────────
# Service account para API routes / SSR. Use UMA das opções abaixo:
#   1. JSON inline da service account
FIREBASE_SERVICE_ACCOUNT_JSON=""
#   2. Mesmo JSON, porém codificado em base64 (útil em CI / App Hosting)
FIREBASE_SERVICE_ACCOUNT_BASE64=""
#   3. Caminho para o arquivo .json da service account (relativo à raiz do repo)
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ── Testes cloud (test:firestore / test:cloud / test:e2e) ────────────────────
# Suites cloud auto-skipam quando estas variáveis estão ausentes.
# Defina como "true" para rodar contra o projeto de teste luratha-96386.
RUN_CLOUD_TESTS=""
# Config web do projeto de teste, em base64 (alternativa às NEXT_PUBLIC_* acima).
FIREBASE_WEB_APP_CONFIG_BASE64=""
