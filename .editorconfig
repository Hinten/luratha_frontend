# EditorConfig — cross-editor baseline, aligned with prettier.config.mjs.
# https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown keeps trailing whitespace (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
