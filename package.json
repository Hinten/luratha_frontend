{
  "name": "luratha-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:firestore": "turbo run test:firestore",
    "test:functions:cloud": "turbo run test:functions:cloud",
    "test:e2e": "turbo run test:e2e",
    "setup:routes": "node docs/create-catalog-routes.mjs",
    "functions:build": "npm --prefix functions run build",
    "functions:install": "npm --prefix functions ci"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "turbo": "^2.9.0",
    "typescript-eslint": "^8.39.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
