{
  "name": "luratha-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:firestore": "turbo run test:firestore",
    "test:functions:cloud": "turbo run test:functions:cloud",
    "test:seo": "turbo run test:seo",
    "test:e2e": "turbo run test:e2e",
    "setup:routes": "node docs/create-catalog-routes.mjs",
    "functions:build": "npm --prefix functions run build",
    "functions:install": "npm --prefix functions ci",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.3",
    "typescript-eslint": "^8.62.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": ">=1.14.4",
      "@grpc/grpc-js@<1.9.16": ">=1.9.16",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "form-data@<2.5.6": ">=2.5.6",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "protobufjs@<=7.6.0": ">=7.6.1",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0"
    }
  }
}
