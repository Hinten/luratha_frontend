{
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions"
    }
  ],
  "firestore": {
    "database": "default",
    "location": "us-east5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "luratha-app-frontend",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions",
      "test",
      "__tests__",
      "*/__tests__",
      "e2e",
      "docs",
      "playwright.config.ts",
      "vitest.config.mts",
      "vitest.cloud.config.mts",
      "vitest.cloud-functions.config.mts",
      "README.md",
      "storage.rules",
      "firestore.rules",
      "playwright-report",
      ".playwright-mcp"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Luratha Auth",
        "supportEmail": "contato@luratha.com.br"
      }
    }
  }
}
