{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(java -version)",
      "Bash(firebase --version)",
      "Bash(npx playwright *)",
      "Bash(nvm --version)",
      "Bash(fnm --version)",
      "Bash(echo \"EXIT:$?\")"
    ],
    "deny": [
      "Edit(node_modules/**)",
      "Write(node_modules/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] && exit 0; cd \"$CLAUDE_PROJECT_DIR\" && npm ci --prefer-offline"
          }
        ]
      }
    ]
  }
}
